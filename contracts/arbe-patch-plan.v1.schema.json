{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cr60.local/contracts/arbe-patch-plan.v1.schema.json",
  "title": "Arbe simulation patch plan v1",
  "description": "Read-only, configurable checks for simulation adaptation and dirty diffs.",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "target",
    "check_specs",
    "checks",
    "source",
    "diagnostics",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "arbe-patch-plan.v1" },
    "status": { "enum": ["planned", "ready", "partial", "needs_action", "blocked", "failed"] },
    "target": {
      "type": "object",
      "required": ["arbe_root", "algo_source_root"],
      "properties": {
        "arbe_root": { "type": "string", "minLength": 1 },
        "algo_source_root": { "type": "string", "minLength": 1 },
        "server_host": { "type": "string" },
        "server_user": { "type": "string" },
        "server_port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "additionalProperties": true
    },
    "command": { "type": "string" },
    "execute_requested": { "type": "boolean" },
    "check_specs": { "type": "array", "items": { "type": "object" }, "minItems": 1 },
    "source": { "type": "object" },
    "checks": { "type": "array", "items": { "type": "object" } },
    "diagnostics": { "type": "array", "items": { "type": "string" } },
    "provenance": { "type": "object" },
    "command_result": { "type": "object" },
    "artifact_path": { "type": "string" }
  },
  "additionalProperties": true
}
