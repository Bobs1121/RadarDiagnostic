{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radar-analyze.local/contracts/analysis-step.v1.schema.json",
  "title": "Analysis Step v1",
  "type": "object",
  "required": [
    "schema_version", "step_id", "run_id", "stage", "status", "started_at",
    "input_artifact_refs", "output_artifact_refs", "tool_calls", "observations",
    "claim_refs", "gaps", "conflicts", "user_visible_summary",
    "next_action_candidates", "metrics"
  ],
  "properties": {
    "schema_version": {"const": "analysis-step.v1"},
    "step_id": {"type": "string"},
    "run_id": {"type": "string"},
    "stage": {"type": "string"},
    "status": {"enum": ["running", "completed", "partial", "blocked", "failed", "skipped"]},
    "created_by": {"type": "string"},
    "started_at": {"type": "string"},
    "finished_at": {"type": "string"},
    "duration_sec": {"type": ["number", "null"]},
    "input_artifact_refs": {"type": "array", "items": {"type": "object"}},
    "output_artifact_refs": {"type": "array", "items": {"type": "object"}},
    "tool_calls": {"type": "array", "items": {"type": "object"}},
    "observations": {"type": "array"},
    "claim_refs": {"type": "array", "items": {"type": "object"}},
    "gaps": {"type": "array"},
    "conflicts": {"type": "array"},
    "user_visible_summary": {"type": "string"},
    "next_action_candidates": {"type": "array"},
    "metrics": {"type": "object"}
  },
  "additionalProperties": true
}
