{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "perception-run.v1",
  "type": "object",
  "required": ["schema_version", "status", "run_id", "attempt_id", "warmup", "observed_frames", "completed_frames", "analyzed_frames", "diagnostics"],
  "properties": {
    "schema_version": {"const": "perception-run.v1"},
    "status": {"enum": ["planned", "blocked", "partial", "completed"]},
    "run_id": {"type": "string"},
    "attempt_id": {"type": "string"},
    "plan_hash": {"type": "string"},
    "plan_hash": {"type": "string"},
    "terminal_status": {"type": "string"},
    "identity": {"type": "object"},
    "warmup": {"type": "object"},
    "observed_frames": {"type": "array", "items": {"type": "string"}},
    "completed_frames": {"type": "array", "items": {"type": "string"}},
    "analyzed_frames": {"type": "array", "items": {"type": "string"}},
    "completed_stage_evidence": {"type": "array", "items": {"type": "object"}},
    "reset_events": {"type": "array", "items": {"type": "object"}},
    "reset_status": {"type": "string"},
    "failure": {"type": "object"},
    "diagnostics": {"type": "array", "items": {"type": "string"}},
    "runtime_proof": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "completed"}}, "required": ["status"]},
      "then": {
        "required": ["plan_hash"],
        "properties": {
          "run_id": {"type": "string", "minLength": 1},
          "attempt_id": {"type": "string", "minLength": 1},
          "plan_hash": {"type": "string", "minLength": 1},
          "runtime_proof": {"enum": ["observed", "completed"]},
          "reset_status": {"const": "ready"},
          "warmup": {"type": "object", "properties": {"status": {"const": "ready"}}, "required": ["status"]},
          "observed_frames": {"type": "array", "minItems": 1},
          "completed_frames": {"type": "array", "minItems": 1}
        }
      }
    }
  ],
  "additionalProperties": true
}
