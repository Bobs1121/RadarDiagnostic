{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radar-analyze.local/contracts/analysis-run.v1.schema.json",
  "title": "Analysis Run v1",
  "type": "object",
  "required": [
    "schema_version", "run_id", "goal", "binding", "policy", "status",
    "current_stage", "created_at", "updated_at", "event_sequence", "steps",
    "claims", "hypotheses", "experiments", "artifacts", "metrics"
  ],
  "properties": {
    "schema_version": {"const": "analysis-run.v1"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "owner": {"type": "string"},
    "goal": {
      "type": "object",
      "required": ["question"],
      "properties": {"question": {"type": "string", "minLength": 1}},
      "additionalProperties": true
    },
    "binding": {"type": "object"},
    "policy": {"type": "object"},
    "status": {"enum": ["created", "running", "partial", "blocked", "failed", "completed"]},
    "current_stage": {"type": "string"},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "event_sequence": {"type": "integer", "minimum": 0},
    "steps": {"type": "array", "items": {"$ref": "#/$defs/entityRef"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/entityRef"}},
    "hypotheses": {"type": "array", "items": {"$ref": "#/$defs/entityRef"}},
    "experiments": {"type": "array", "items": {"$ref": "#/$defs/entityRef"}},
    "user_observations": {"type": "array", "items": {"$ref": "#/$defs/entityRef"}},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "metrics": {"type": "object"}
  },
  "$defs": {
    "entityRef": {
      "type": "object",
      "required": ["kind", "id", "path"],
      "properties": {
        "kind": {"type": "string"},
        "id": {"type": "string"},
        "path": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
