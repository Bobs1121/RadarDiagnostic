    "run": {"type": "object"},
    "counts": {"type": "object"},
    "analysis_trail": {"type": "array", "items": {"type": "object"}},
    "hypothesis_board": {"type": "array", "items": {"type": "object"}},
    "experiments": {"type": "array", "items": {"type": "object"}},
    "user_observations": {"type": "array", "items": {"type": "object"}},
    "feedback": {"type": "array", "items": {"type": "object"}},
    "feedback_review": {"type": "object"},
    "next_actions": {"type": "array", "items": {"type": "object"}},
    "provenance": {"type": "object"},
    "policy": {"type": "string"}
