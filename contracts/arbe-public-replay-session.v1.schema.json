{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cr60.local/contracts/arbe-public-replay-session.v1.schema.json",
  "title": "Remote arbe public replay session v1",
  "description": "Auditable plan/result for one short SSH replay that records public ROS outputs.",
  "type": "object",
  "required": ["schema_version", "status", "mode", "target", "command", "execute_requested", "diagnostics"],
  "properties": {
    "schema_version": {"const": "arbe-public-replay-session.v1"},
    "status": {"enum": ["planned", "approval_required", "completed", "partial", "failed", "timeout"]},
    "mode": {"const": "remote_public"},
    "target": {"type": "object", "additionalProperties": true},
    "command": {"type": "string"},
    "execute_requested": {"type": "boolean"},
    "analysis_options": {
      "type": "object",
      "properties": {
        "object_association_mode": {"enum": ["strict", "publication_order"]},
        "object_validity_policy": {"enum": ["preserve", "arbe_wf_sobj"]}
      },
      "additionalProperties": true
    },
    "remote_capture_bag": {"type": "string"},
    "remote_capture_json": {"type": "string"},
    "marker_result": {"type": "object", "additionalProperties": true},
    "command_result": {"type": "object", "additionalProperties": true},
    "fetch_result": {"type": "object", "additionalProperties": true},
    "local_capture_json": {"type": "string"},
    "runtime_snapshot": {"type": "object", "additionalProperties": true},
    "lifecycle": {"type": "object", "additionalProperties": true},
    "completion": {"type": "object", "additionalProperties": true},
    "perception_capture": {"type": "object", "additionalProperties": true},
    "analysis_handoff": {
      "type": "object",
      "properties": {
        "status": {"enum": ["ready", "not_available"]},
        "recommended_tool": {"const": "point-cloud-analyze"},
        "capture_path": {"type": "string"},
        "replay_plan_hash": {"type": "string"},
        "execution_binding_run_id": {"type": "string"},
        "provenance": {"type": "object", "additionalProperties": true},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "diagnostics": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "diagnostics": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "artifact_path": {"type": "string"}
  },
  "additionalProperties": true
}
