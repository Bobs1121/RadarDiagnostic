{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cr60.local/contracts/pi-orchestration-context.v1.schema.json",
  "title": "Pi orchestration context v1",
  "description": "Immutable, provenance-preserving context bound to one Pi run.",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "run_id",
    "context_fingerprint",
    "project",
    "data",
    "source",
    "build",
    "runtime",
    "policy",
    "artifacts",
    "freshness",
    "missing",
    "conflicts",
    "diagnostics"
  ],
  "properties": {
    "schema_version": { "const": "pi-orchestration-context.v1" },
    "task_scope": { "enum": ["case_analysis", "source_code"] },
    "status": { "enum": ["ready", "partial", "blocked"] },
    "run_id": { "type": "string", "minLength": 1 },
    "context_fingerprint": { "type": "string", "minLength": 1 },
    "operator": { "type": "string" },
    "project_root": { "type": "string" },
    "project": { "type": "object" },
    "data": { "type": "object" },
    "source": {
      "type": "object",
      "properties": {
        "source_snapshot_hash": { "type": "string" },
        "code_context_path": { "type": "string" },
        "code_context_sha256": { "type": "string" },
        "code_index_path": { "type": "string" },
        "code_index_hash": { "type": "string" },
        "code_index_snapshot_hash": { "type": "string" },
        "code_context": {
          "type": "object",
          "properties": {
            "schema_version": { "const": "code-context.v1" },
            "source_root": { "type": "string" },
            "source_snapshot_hash": { "type": "string" },
            "code_context_path": { "type": "string" },
            "code_context_sha256": { "type": "string" },
            "code_index_path": { "type": "string" },
            "code_index_hash": { "type": "string" },
            "code_index_snapshot_hash": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "build": { "type": "object" },
    "runtime": { "type": "object" },
    "policy": { "type": "object" },
    "artifacts": { "type": "array", "items": { "type": "object" } },
    "freshness": { "type": "object" },
    "missing": { "type": "array", "items": { "type": "string" } },
    "conflicts": { "type": "array", "items": { "type": "object" } },
    "diagnostics": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
