{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cr60.local/contracts/runtime-snapshot-with-frame.v1.schema.json",
  "title": "CR60 public arbe runtime snapshot with frame association",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "source_context",
    "warning_rising_edges",
    "snapshots",
    "unbound_objects",
    "association_policy",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {"const": "runtime-snapshot-with-frame.v1"},
    "status": {"type": "string", "enum": ["ready", "partial", "blocked"]},
    "source_context": {"type": "object"},
    "capture_metadata": {
      "type": "object",
      "properties": {
        "schema_version": {"const": "public-runtime-capture-metadata.v1"},
        "origin_schema_version": {"type": "string"},
        "inventory_path": {"type": ["string", "null"]},
        "inventory_sha256": {"type": ["string", "null"]},
        "inventory_status": {"type": "string"},
        "requested_topics": {"type": "array", "items": {"type": "string"}},
        "inventory_observed_at_utc": {"type": ["string", "null"]},
        "identity_binding": {"type": "object"},
        "topic_plan_binding_status": {"type": "string"},
        "observed_sample_count": {"type": "integer", "minimum": 0},
        "observed_objectlist_topic_count": {"type": "integer", "minimum": 0},
        "topic_samples": {"type": "array", "items": {"type": "object"}},
        "association_policy": {"type": "object"}
      },
      "additionalProperties": true
    },
    "warning_rising_edges": {"type": "array", "items": {"type": "object"}},
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["radar_id", "frame_id", "association_status", "objects"],
        "properties": {
          "radar_id": {},
          "frame_id": {},
          "association_status": {"enum": ["frame_verified", "callback_correlated", "publication_correlated", "unbound"]},
          "warning": {"type": ["object", "null"]},
          "radar_info": {"type": ["object", "null"]},
          "objects": {"type": "array", "items": {"type": "object"}},
          "object_association_status": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "ignored_objects": {"type": "array", "items": {"type": "object"}},
    "unbound_objects": {"type": "array", "items": {"type": "object"}},
    "association_policy": {"type": "object"},
    "diagnostics": {"type": "array", "items": {"type": "string"}},
    "artifact_path": {"type": "string"}
  },
  "additionalProperties": true
}
