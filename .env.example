# Copy this file to .env and fill in your values
# cp .env.example .env

# Local Ollama (optional, defaults are usually fine)
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=ollama

# Remote model server
REMOTE_BASE_URL=http://your-server:port/model/v1
REMOTE_API_KEY=your-api-key-here

# Pi/radarAnalyze runtime (optional; use when these are not supplied by the shell)
# CR60_PI_PROVIDER=
# CR60_PI_MODEL=
# CR60_PI_EXECUTABLE=
# CR60_RADAR_ANALYZE_PYTHON=
