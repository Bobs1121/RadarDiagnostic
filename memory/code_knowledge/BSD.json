    "trigger_conditions": [
      {
        "id": "trig-1",
        "description": "BSD 系统状态激活（允许报警的前提条件）：车速在范围内且曲率半径满足要求。代码片段未直接展示系统状态更新函数内部，但参数定义明确了阈值。",
        "c_expression": "curV >= fBsdActiveSpd && curV <= fBsdActiveUpperSpd && radius >= fBsdActiveCurbRadius",
        "variables": [
          "fBsdActiveSpd",
          "fBsdActiveUpperSpd",
          "fBsdActiveCurbRadius",
          "bsdSystemState"
        ],
        "thresholds": {
          "fBsdActiveSpd": "12.0 km/h",
          "fBsdActiveUpperSpd": "146.0 km/h",
          "fBsdActiveCurbRadius": "125.0 m"
        },
        "code_ref": {
          "file": "adasFunc.c",
          "line": 52,
          "function": "GlobalParamsDefinition"
        },
        "confidence": 0.85,
        "_learned_at": "2026-04-18T17:29:16.314108"
      },
      {
        "id": "trig-2",
        "description": "目标对象触发报警阈值：相对速度与绝对速度满足警告条件。逻辑隐含在对象标志位设置流程中，参数定义了判断边界。",
        "c_expression": "obj.relVx < fBsdObjWarningRelVx && obj.spd > fBsdObjWarningSpd",
        "variables": [
          "fBsdObjWarningRelVx",
          "fBsdObjWarningSpd",
