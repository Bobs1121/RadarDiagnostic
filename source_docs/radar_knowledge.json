      "bsdSystemState": "bsd_system_state",
      "lcaSystemState": "lca_system_state",
      "dowSystemState": "dow_system_state",
      "rcwSystemState": "rcw_system_state",
      "rctaSystemState": "rcta_system_state",
      "rctbSystemState": "rctb_system_state",
      "PERInputUpdate.adasEnable.bFCTAEnable": "fcta_enable",
      "PERInputUpdate.adasEnable.bFCTBEnable": "fctb_enable",
      "PERInputUpdate.adasEnable.bBSDEnable": "bsd_enable",
      "PERInputUpdate.adasEnable.bLCAEnable": "lca_enable",
      "PERInputUpdate.adasEnable.bDOWEnable": "dow_enable",
