    "bytes": {
      "0": "radar_id",
      "1": "BSD_L (BSD_LCA_warningReqleft)",
      "2": "BSD_R (BSD_LCA_warningReqright)",
      "3": "LCA_L (RSDS_LCA_WarReqLeft)",
      "4": "LCA_R (RSDS_LCA_WarReqRight)",
      "5": "DOW_L (RSDS_DOWWarReqLeft)",
      "6": "DOW_R (RSDS_DOWWarReqRight)",
      "7": "RCW (RSDS_RCW_Trigger)",
      "8": "RCTA_L (RSDS_RCTA_WarReqLeft)",
      "9": "RCTA_R (RSDS_RCTA_WarReqRight)",
      "10": "RCTB_L (RSDS_RCTB_WarReqLeft)",
      "11": "RCTB_R (RSDS_RCTB_WarReqRight)",
      "12": "FCTA_L (RRadar_FCTA_Warning_Left_S)",
      "13": "FCTA_R (RRadar_FCTA_Warning_Right_S)",
      "14": "FCTB_L (RRadar_FCTB_Warning_Left_S)",
      "15": "FCTB_R (RRadar_FCTB_Warning_Right_S)"
    }
  },

  "a2l_to_egoCarInfo": {
    "source": "SAIC_pri_can/canfd_sgu_pub.py SIGNAL_SPECS",
    "mappings": {
      "g_egoCarAddInfo.carSpd": "car_spd",
      "g_egoCarAddInfo.carAccXr": "car_acc_xr",
      "g_egoCarAddInfo.yawRate": "yaw_rate",
      "g_egoCarAddInfo.steerAngle": "steer_angle",
