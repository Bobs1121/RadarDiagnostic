  "wfAutosarData_structure": {
    "header_magic": ["0xA55A", "0x5AA5"],
    "fixed_length": 728,
    "debug_info_offset": 584,
    "debug_info_size": 144,
    "obj_offset": 8,
    "obj_size": 36,
    "max_objects": 68,
    "dot_out_size": 16,
    "object_fields": [
      "dist_x(i16/100)", "dist_y(i16/100)", "length(u16/100)", "width(u16/100)",
      "yaw_ang(i16/100)", "obj_id(u8)", "obj_type(u8)", "dyn_flg(u8)",
      "bsd(i8)", "lca(i8)", "dow(i8)", "rcw(i8)", "rcta(i8)", "rctb(i8)", "fcta(i8)", "fctb(i8)",
      "refer_pt(u8)", "life_cycle(u8)", "padding(1B)",
      "vel_x(i16/100)", "vel_y(i16/100)", "vel_abs_x(i16/100)", "vel_abs_y(i16/100)",
      "f_ttc(u16/100)", "f_ddci(i16/100)"
