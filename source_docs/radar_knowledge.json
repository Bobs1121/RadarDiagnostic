    "debug_sections": ["egoCarInfoTrans(60B)", "calibInfoTrans(12B)", "ADASInfoTrans(12B)", "BLDInfoTrans(60B)"]
  },

  "adas_functions": {
    "rear": ["BSD", "LCA", "DOW", "RCW", "RCTA", "RCTB"],
    "front": ["FCTA", "FCTB"],
    "system_state_enum": {
      "0": "None", "1": "Init", "2": "Standby", "3": "Active",
      "4": "Off", "5": "Failure", "6": "Passive"
    }
  }
