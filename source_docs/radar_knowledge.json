    "0x601": {"name": "RR", "position": "rear_right", "topic_suffix": 4},
    "0x602": {"name": "FR", "position": "front_right", "topic_suffix": 1},
    "0x603": {"name": "FL", "position": "front_left", "topic_suffix": 2}
  },

  "topic_to_radar": {
    "/wf/corner_radar/lgu_data_1": {"radar": "FR", "radar_id": 1},
    "/wf/corner_radar/lgu_data_2": {"radar": "FL", "radar_id": 2},
    "/wf/corner_radar/lgu_data_3": {"radar": "RL", "radar_id": 3},
    "/wf/corner_radar/lgu_data_4": {"radar": "RR", "radar_id": 4},
