{
  "function": "FCTB",
  "system_state": {
    "state_values": {
      "0": "None",
      "1": "Init",
      "2": "Standby",
      "3": "Active",
      "4": "Off",
      "5": "Failure",
      "6": "Passive"
    },
    "transitions": [
      {
        "from": "0",
        "to": "1",
        "conditions": [
          {
            "condition": "System self-inspection finished",
            "variable": "g_DTCCode.selfInspFlg",
            "threshold": "TRUE",
            "source": "adasFunc.c:2547"
          }
        ]
      },
      {
        "from": "1",
        "to": "5",
        "conditions": [
          {
            "condition": "FCTB Fault detected",
            "variable": "g_DTCCode.failureFlg",
            "threshold": "TRUE",
            "source": "adasFunc.c:2616"
          }
        ]
      },
      {
        "from": "1",
        "to": "4",
        "conditions": [
          {
            "condition": "Calibration in progress",
            "variable": "g_DTCCode.calibratingFlg",
            "threshold": "TRUE",
            "source": "adasFunc.c:2614"
          }
        ]
      },
      {
        "from": "1",
        "to": "2",
        "conditions": [
          {
            "condition": "Gear is D or R (4 or 5)",
            "variable": "g_egoCarAddInfo.actual_gear",
            "threshold": "== 4 || == 5",
            "source": "adasFunc.c:2622"
          },
          {
            "condition": "Brake ready",
            "variable": "g_DTCCode.bBrakeNotReadyFlg",
            "threshold": "FALSE",
            "source": "adasFunc.c:2623"
          },
          {
            "condition": "Speed within active range",
            "variable": "g_egoCarAddInfo.carSpd",
            "threshold": ">= 0.5 && <= 21.0 km/h",
            "source": "adasFunc.c:2625"
          },
          {
            "condition": "Standby to Active conditions met",
            "variable": "FCTB_Standby2Active",
            "threshold": "TRUE",
            "source": "ASWIN_SystemState.c:1626"
          }
        ]
      },
      {
        "from": "2",
        "to": "3",
        "conditions": [
          {
            "condition": "Warning output active",
            "variable": "PEROutput.adasWarning.bLeftFctbWarning || PEROutput.adasWarning.bRightFctbWarning",
            "threshold": "!= 0",
            "source": "ASWIN_SystemState.c:733"
          },
          {
            "condition": "Function gap check passed",
            "variable": "FCTBFuncGap",
            "threshold": "TRUE",
            "source": "ASWIN_SystemState.c:733"
          }
        ]
      },
      {
        "from": "2,3",
        "to": "6",
        "conditions": [
          {
            "condition": "Speed out of active range",
            "variable": "g_egoCarAddInfo.carSpd",
            "threshold": ">= 22.0 || < 0.0 km/h",
            "source": "adasFunc.c:2634"
          }
        ]
      },
      {
        "from": "*",
        "to": "4",
        "conditions": [
          {
            "condition": "FCTB Enable condition failed",
            "variable": "GWM_FCTB_AdasEnableCond",
            "threshold": "FALSE",
            "source": "ASWIN_SystemState.c:1615"
          }
        ]
      }
    ]
  },
  "target_filter": {
    "skip_function": "FctaSkipFlg",
    "conditions": [
      {
        "condition": "Target speed out of warning range",
        "variable": "objAbsV",
        "threshold": "< 0.5 km/h || > 22.0 km/h",
        "note": "Enter/Exit logic in FctaSkipFlg"
      }
    ]
  },
  "detect_enable": {
    "flag": "bFctbDetectFlg",
    "conditions": [
      {
        "condition": "Ego speed within detection range",
        "variable": "g_egoCarAddInfo.carSpd",
        "threshold": ">= 0.5 && <= 22.0 km/h"
      }
    ]
  },
  "ego_speed_ranges": {
    "active": {
      "low": "fFctbActiveLowSpd=0.5",
      "high": "fFctbActiveUpSpd=21.0",
      "unit": "km/h"
    },
    "deactive": {
      "low": "fFctbDeactiveLowSpd=0.0",
      "high": "fFctbDeactiveUpSpd=22.0",
      "unit": "km/h"
    },
    "detect": {
      "low": "fFctbDetectLowSpd=0.5",
      "high": "fFctbDetectUpSpd=22.0",
      "unit": "km/h"
    }
  },
  "target_speed_ranges": {
    "warning_enter": {
      "low": "fFctaObjWarningSpd=0.5",
      "high": "fFctaObjWarningUpSpd=22.0",
      "unit": "km/h"
    },
    "warning_exit": {
      "low": "fFctaObjDeWarningSpd=0.5",
      "high": "fFctaObjDeWarningUpSpd=22.0",
      "unit": "km/h"
    }
  },
